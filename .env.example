# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Browser/frontend integration
VITE_DJANGO_URL=

# Django -> FastAPI proxy
RETENTIONPULSE_API_URL=http://127.0.0.1:8001
RETENTIONPULSE_MAX_UPLOAD_BYTES=262144000

# WebAuthn / passkeys
# For local development, keep these values aligned with the browser URL.
RETENTIONPULSE_RP_ID=127.0.0.1
RETENTIONPULSE_ORIGIN=http://127.0.0.1:8000
RETENTIONPULSE_RP_NAME=RetentionPulse
RETENTIONPULSE_WEBAUTHN_TIMEOUT_MS=60000

# Production example:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=app.example.com
# RETENTIONPULSE_RP_ID=app.example.com
# RETENTIONPULSE_ORIGIN=https://app.example.com
