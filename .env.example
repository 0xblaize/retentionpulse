# FastAPI
RETENTIONPULSE_SECRET_KEY=replace-with-a-long-random-secret

# Browser/frontend integration
VITE_API_URL=
RETENTIONPULSE_FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
RETENTIONPULSE_MAX_UPLOAD_BYTES=262144000

# Offline multimodal analysis
RETENTIONPULSE_ANALYSIS_MODE=auto
RETENTIONPULSE_OFFLINE_MODE=1
RETENTIONPULSE_FFMPEG=ffmpeg
RETENTIONPULSE_MODEL_CACHE=./model-cache
# These must point to directories already present in the offline model cache.
RETENTIONPULSE_WHISPER_MODEL=
RETENTIONPULSE_EMBEDDING_MODEL=

# Optional Groq repair-plan advisor. Set the API key to enable written plans.
RETENTIONPULSE_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
RETENTIONPULSE_LLM_API_KEY=
RETENTIONPULSE_LLM_MODEL=llama-3.3-70b-versatile

# WebAuthn / passkeys
# For local development, keep these values aligned with the browser URL.
RETENTIONPULSE_RP_ID=127.0.0.1
RETENTIONPULSE_ORIGIN=http://127.0.0.1:8000
RETENTIONPULSE_RP_NAME=RetentionPulse
RETENTIONPULSE_WEBAUTHN_TIMEOUT_MS=60000

# Production example:
# RETENTIONPULSE_RP_ID=app.example.com
# RETENTIONPULSE_ORIGIN=https://app.example.com
